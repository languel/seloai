{
  "name": "seloai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mcp": "node mcp/seloai-mcp-server.mjs",
